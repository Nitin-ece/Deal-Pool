# Frontend — DealPool
# Leave VITE_API_BASE_URL empty in local dev so Vite proxies /api → backend.

VITE_API_BASE_URL=
VITE_BACKEND_URL=http://localhost:3000

# Firebase Web config (same project as backend). Required for Google sign-in.
# Enable Google provider in Firebase Console → Authentication → Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
