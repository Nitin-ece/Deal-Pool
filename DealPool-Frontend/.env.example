# Frontend — DealPool
# Leave VITE_API_BASE_URL empty in local dev so Vite proxies /api → backend.

VITE_API_BASE_URL=
VITE_BACKEND_URL=http://localhost:3000

# Google Maps Platform API Key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Firebase Web config (same project as backend). Required for Google sign-in.
# Enable Google provider in Firebase Console → Authentication → Sign-in method.
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id-here
